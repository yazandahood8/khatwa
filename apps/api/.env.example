# ===========================================
#  Khatwa API — Environment Variables
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية
#  cp .env.example .env
# ===========================================

# البيئة — Environment
NODE_ENV=development
PORT=4000

# أصل الواجهة (CORS) — Frontend origin
WEB_ORIGIN=http://localhost:3000

# قاعدة البيانات — Supabase PostgreSQL
# من: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

# Redis — Rate Limiting + Caching (Upstash أو Railway)
# مطلوب من Sprint 7 — اتركه فارغاً الآن إن لم يكن جاهزاً
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"

# المصادقة — Auth (Sprint 2)
JWT_SECRET="change-me-to-a-long-random-secret-string"

# الذكاء الاصطناعي — Claude (Sprint 7)
ANTHROPIC_API_KEY="sk-ant-..."

# AWS S3 — تخزين الفيديوهات (Sprint 3)
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="khatwa-videos"
AWS_CLOUDFRONT_URL=""
