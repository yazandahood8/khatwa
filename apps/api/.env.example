# ===========================================
#  Khatwa API — Environment Variables
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية
#  cp .env.example .env
# ===========================================

# البيئة — Environment
NODE_ENV=development
PORT=4000

# أصل الواجهة (CORS) — Frontend origin
WEB_ORIGIN=http://localhost:3000

# قاعدة البيانات — Supabase PostgreSQL
# DATABASE_URL = Transaction pooler (port 6543) — وقت التشغيل
# DIRECT_URL   = Session pooler / Direct (port 5432) — للـ migrations
# من: Supabase Dashboard → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis — Rate Limiting + Caching (Upstash أو Railway)
# مطلوب من Sprint 7 — اتركه فارغاً الآن إن لم يكن جاهزاً
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"

# المصادقة — Auth (Sprint 2)
JWT_SECRET="change-me-to-a-long-random-secret-string"

# الذكاء الاصطناعي — Claude (Sprint 7)
ANTHROPIC_API_KEY="sk-ant-..."

# البريد — Transactional email over SMTP (provider-agnostic; optional)
# اتركه فارغاً للتطوير: تُسجَّل الرسائل في اللوج بدل إرسالها.
# يعمل مع Resend / SES / Mailgun / Gmail… (استخدم بيانات SMTP الخاصة بالمزوّد)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="خطوة <no-reply@khatwa.app>"

# تخزين الفيديوهات — Object storage (Cloudflare R2, S3-compatible)
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET="khatwa-videos"
S3_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"
