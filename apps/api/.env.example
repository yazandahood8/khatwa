# ===========================================
#  Khatwa API — Environment Variables
#  انسخ هذا الملف إلى .env واملأ القيم الحقيقية
#  cp .env.example .env
# ===========================================

# البيئة — Environment
NODE_ENV=development
PORT=4000

# أصل الواجهة (CORS) — Frontend origin
WEB_ORIGIN=http://localhost:3000

# قاعدة البيانات — Supabase PostgreSQL
# DATABASE_URL = Transaction pooler (port 6543) — وقت التشغيل
# DIRECT_URL   = Session pooler / Direct (port 5432) — للـ migrations
# من: Supabase Dashboard → Connect → ORMs → Prisma
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis — Rate Limiting + Caching (Upstash أو Railway)
# مطلوب من Sprint 7 — اتركه فارغاً الآن إن لم يكن جاهزاً
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"

# المصادقة — Auth (Sprint 2)
JWT_SECRET="change-me-to-a-long-random-secret-string"

# الذكاء الاصطناعي — Claude (Sprint 7)
ANTHROPIC_API_KEY="sk-ant-..."

# AWS S3 — تخزين الفيديوهات (Sprint 3)
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="khatwa-videos"
AWS_CLOUDFRONT_URL=""
