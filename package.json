{
  "name": "khatwa",
  "version": "0.1.0",
  "private": true,
  "description": "منصة تعليمية تفاعلية للطلاب العرب في إسرائيل - Smart tutoring platform",
  "author": "Yazan Daoud",
  "license": "UNLICENSED",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:web": "npm run build --workspace=frontend",
    "build:api": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:e2e": "node e2e/browser/run.mjs",
    "test:e2e:headed": "node e2e/browser/run.mjs --headed",
    "test:e2e:ui": "node e2e/browser/run.mjs --ui",
    "test:e2e:down": "docker compose -f e2e/shared/docker-compose.e2e.yml -p khatwa-e2e down -v",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "husky": "^9.1.7",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
